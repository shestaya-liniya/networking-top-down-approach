	"nodes":[
		{"id":"a98a3b04d91d5f07","type":"text","text":"# Access network\nConnects the destination system with the first (or last) router called the \"destination router\"","x":-326,"y":-92,"width":250,"height":181},
		{"id":"fd9a1c252be115de","type":"text","text":"# Core network\nPart of network which connects other networks\n\nConnects ISP with access networks","x":-326,"y":-396,"width":250,"height":224},
		{"id":"155844554c7c396c","type":"text","text":"# Router\n(маршрутизатор)\n","x":63,"y":-310,"width":294,"height":135},
		{"id":"555fc228e5aaa794","type":"text","text":"# Hosts or destination systems","x":-356,"y":160,"width":310,"height":100},
		{"id":"3b68ef14786a356e","type":"text","text":"# Broadband Internet Access\n(широкополосное подключение)\nAcces to the internet which allows the transfer of big data and high speed","x":-756,"y":-151,"width":250,"height":240},
		{"id":"39b456343df0f2c0","type":"text","text":"# ISP\nInternet Service Provider","x":79,"y":-654,"width":256,"height":111},
		{"id":"bbec9eb63129527d","type":"text","text":"# DSL\n(абонентская цифровая ли-\nния)\nDigital Subscriber Line\n\nThe phone line provider company also provide the internet, so the internet connection pass through the existant phone lines","x":620,"y":-840,"width":250,"height":297},
		{"id":"c420e0ab8dbd86a2","type":"text","text":"# Cable or HFC\nHybrid Fiber-Coaxial\n\nThe wire access to the internet pass through the existant TV connection lines\n\nMultiple homes are connected to the same segment of a cable, because of that the speed of transfer can slow down on high load","x":620,"y":-500,"width":250,"height":340},
		{"id":"f18d85edbe4ee5fc","type":"text","text":"# FTTH\nFiber To The Home","x":620,"y":-1000,"width":250,"height":100},
		{"id":"f27fcf3459fbdd3b","type":"text","text":"# PON\nPassive Optical Networks","x":940,"y":-1080,"width":250,"height":100},
		{"id":"f25f18d00b71ae04","type":"text","text":"# AON\nActive Optical Networks","x":940,"y":-900,"width":250,"height":100},
		{"id":"d1c3fedfcb43e356","type":"text","text":"# L2 switch\n(коммутатор канального уровня)\n","x":85,"y":74,"width":250,"height":144},
		{"id":"c3b205bbace5bd49","type":"text","text":"# LAN\nLocal  Area Network","x":430,"y":107,"width":250,"height":103},
